use http;
use io;

let upstream_host = "127.0.0.1";
let upstream_port = 18082;
let upstream_path = "/events";

// Start the upstream exchange and mirror the SSE response head.
let upstream = http::exchange::default_upstream();
http::exchange::set_target(upstream, upstream_host, upstream_port);
http::exchange::set_path(upstream, upstream_path);

let status = http::exchange::get_status(upstream);
http::response::set_status(status);

let content_type = exchange_header_text(upstream, "content-type");
if content_type != "" {
    http::response::set_header("content-type", content_type);
}
http::response::set_header("x-sse-mutated", "true");
http::response::stream::start();

// Read the upstream SSE stream line-by-line so event boundaries stay visible.
let mut event = "";

while !http::exchange::body::eof(upstream) {
    let line = io_line_text(upstream);
    if line == "" {
        if event != "" {
            http::response::stream::write(event + "\n");
            event = "";
        }
    } else {
        event = event + line + " [mutated]\n";
    }
}

if event != "" {
    http::response::stream::write(event + "\n");
}

http::response::stream::finish();

// `http::exchange::get_header` reports an absent header or an undecodable
// value instead of returning an empty string. This sample only needs the value,
// so absence and a malformed value keep the previous empty-string default.
fn exchange_header_text(exchange: int, name: string) -> string {
    let value: Result<Option<string>, string> = http::exchange::get_header(exchange, name);
    match value {
        Result::Ok(present) => match present {
            Option::Some(text) => text,
            Option::None => "",
        },
        Result::Err(error) => "",
    }
}

// `io::read_line` reports end of stream as `Option::None` and a read failure as
// the guest error instead of returning an empty string. The loop tests `eof`,
// so an absent line keeps the previous empty-string boundary default.
fn io_line_text(handle: int) -> string {
    let value: Result<Option<string>, string> = io::read_line(handle);
    match value {
        Result::Ok(present) => match present {
            Option::Some(text) => text,
            Option::None => "",
        },
        Result::Err(error) => "",
    }
}
